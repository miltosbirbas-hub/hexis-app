;; ---------------- globals ----------------
(if (null *DL*) (setq *DL* nil))
(defun dl:get (k / a) (if (setq a (assoc k *DL*)) (cdr a) ""))
(defun dl:geti (k) (atoi (dl:get k)))
(defun dl:set (k v) (setq *DL* (subst (cons k v) (assoc k *DL*) *DL*))
  (if (null (assoc k *DL*)) (setq *DL* (cons (cons k v) *DL*))) v)
(defun dl:nz (s) (and s (/= s "") (/= s " ")))

(defun dl:init ( / d)
  (setq d (list
    (cons "eidos" "0") (cons "kor" "") (cons "emb" "") (cons "thesi" "")
    (cons "dk" "") (cons "dimos" "") (cons "pe" "") (cons "ot" "") (cons "kaek" "")
    (cons "pos" "3") (cons "gps" "0") (cons "gpsfek" "") (cons "zoe" "0") (cons "zoefek" "")
    (cons "parad" "0") (cons "fekrym" "") (cons "fekoron" "") (cons "oikfek" "")
    (cons "artio" "1") (cons "vasi" "0") (cons "oik" "1") (cons "artemb" "")
    (cons "pros" "") (cons "odos" "2") (cons "katat" "1") (cons "katdate" "")
    (cons "n1337" "0") (cons "eisgi" "0") (cons "eisxr" "0") (cons "praxi" "2")
    (cons "n2242" "0") (cons "ktim" "1") (cons "aig" "0") (cons "aigd" "")
    (cons "rema" "0") (cons "remad" "") (cons "dasos" "0") (cons "arxaio" "0")
    (cons "dei" "0") (cons "aerio" "0")
    (cons "mix" "") (cons "eid" "") (cons "tee" "") (cons "idio" "") (cons "pat" "")
    (cons "afm" "") (cons "klim" "500") (cons "mon" "0") (cons "hmm" "2.5")
    (cons "wmm" "90") (cons "d651" "1") (cons "d4030" "1") (cons "hmer" "")
  ))
  (if (null *DL*) (setq *DL* d)
    (foreach p d (if (null (assoc (car p) *DL*)) (setq *DL* (cons p *DL*))))
  )
  ;; γέφυρα με OROIDOM: αν έχει τρέξει, παίρνουμε ΟΤ / περιοχή
  (if *BRB-OROI*
    (progn
      (if (and (assoc "OT" *BRB-OROI*) (not (dl:nz (dl:get "ot"))))
          (dl:set "ot" (cdr (assoc "OT" *BRB-OROI*))))
      (if (and (assoc "PERIOXI" *BRB-OROI*) (not (dl:nz (dl:get "thesi"))))
          (dl:set "thesi" (cdr (assoc "PERIOXI" *BRB-OROI*))))
      (if (and (assoc "FEK" *BRB-OROI*) (not (dl:nz (dl:get "fekoron"))))
          (dl:set "fekoron" (cdr (assoc "FEK" *BRB-OROI*))))
    ))
  (if (not (dl:nz (dl:get "hmer"))) (dl:set "hmer" (dl:today)))
  ;; αυτόματη ανάγνωση ιδιοκτησίας από το layer TOPO_PROP
  (if (not (dl:nz (dl:get "kor"))) (dl:prop-info T))
  (princ))

(defun dl:today ( / d)
  (setq d (rtos (getvar "CDATE") 2 6))
  (strcat (substr d 7 2) "/" (substr d 5 2) "/" (substr d 1 4)))

