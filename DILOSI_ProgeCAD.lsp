;; ---------------- κορυφές από το σχέδιο ----------------
(defun dl:label (i / n r)
  (setq n (length *DL-ALFA*))
  (if (< i n) (nth i *DL-ALFA*)
    (strcat (nth (rem i n) *DL-ALFA*) (itoa (/ i n)))))

(setq *DL-LAYER* "TOPO_PROP")

;; καθαρισμός mtext formatting
(defun dl:strip (s / p)
  (if (and (> (strlen s) 0) (= (substr s 1 1) "{"))
    (progn
      (setq s (vl-string-trim "{}" s))
      (if (setq p (vl-string-search ";" s)) (setq s (substr s (+ p 2))))))
  (vl-string-trim " \t" s))

;; όλα τα σημεία κορυφών μιας LWPOLYLINE, με τη σειρά
(defun dl:verts (e / d lst)
  (setq lst nil)
  (foreach d (entget e)
    (if (= (car d) 10) (setq lst (cons (cdr d) lst))))
  (reverse lst))

;; κείμενα ονομασιών στο layer, ως ((σημείο . κείμενο) ...)
(defun dl:labels (lay / ss i e d p t0 lst)
  (setq ss (ssget "_X" (list (cons 0 "TEXT,MTEXT") (cons 8 lay)
                             (cons 410 (getvar "CTAB")))))
  (setq lst nil i 0)
  (if ss
    (while (< i (sslength ss))
      (setq e (ssname ss i) d (entget e))
      (setq p (cdr (assoc 11 d)))
      (if (or (null p) (equal p (list 0.0 0.0 0.0) 1e-8)) (setq p (cdr (assoc 10 d))))
      (setq t0 (dl:strip (cdr (assoc 1 d))))
      (if (and t0 (> (strlen t0) 0) (< (strlen t0) 5))
        (setq lst (cons (cons p t0) lst)))
      (setq i (1+ i))))
  lst)

;; μέσο μήκος πλευράς (για ανοχή αντιστοίχισης)
(defun dl:avgseg (pts / n i s)
  (setq n (length pts) i 0 s 0.0)
  (while (< i (1- n))
    (setq s (+ s (distance (nth i pts) (nth (1+ i) pts))))
    (setq i (1+ i)))
  (if (> n 1) (/ s (float (1- n))) 1.0))

;; ---- η βασική: διαβάζει την ιδιοκτησία από το layer TOPO_PROP ----
(defun dl:prop-info (silent / ss e o n i j pts txts tol best bd d nm fst used s ar)
  (setq ss (ssget "_X" (list (cons 0 "LWPOLYLINE") (cons 8 *DL-LAYER*)
                             (cons 410 (getvar "CTAB")))))
  (cond
    ((null ss)
     (if (not silent)
       (progn
         (princ (strcat "\n" "Δεν βρέθηκε πολύγωνο στο layer " *DL-LAYER* " - επιλέξτε χειροκίνητα: "))
         (setq e (car (entsel))))))
    ((= (sslength ss) 1) (setq e (ssname ss 0)))
    (T
     ;; πολλά πολύγωνα: κρατάμε το μεγαλύτερο, εκτός αν ο χρήστης δείξει άλλο
     (if silent
       (progn
         (setq i 0 bd -1.0)
         (while (< i (sslength ss))
           (setq o (vlax-ename->vla-object (ssname ss i)))
           (if (> (vla-get-Area o) bd)
             (setq bd (vla-get-Area o) e (ssname ss i)))
           (setq i (1+ i))))
       (progn
         (princ (strcat "\n" "Βρέθηκαν " (itoa (sslength ss))
                        " πολύγωνα στο " *DL-LAYER* " - δείξτε το σωστό: "))
         (setq e (car (entsel)))))))
  (if (and e (= (cdr (assoc 0 (entget e))) "LWPOLYLINE"))
    (progn
      (setq o (vlax-ename->vla-object e))
      (setq ar (vla-get-Area o))
      (setq pts (dl:verts e))
      (setq n (length pts))
      (setq txts (dl:labels *DL-LAYER*))
      (setq tol (* 0.55 (dl:avgseg pts)))
      (setq used nil s "" i 0)
      (while (< i n)
        (setq best nil bd tol)
        (foreach d txts
          (if (not (member d used))
            (progn
              (setq j (distance (list (car (car d)) (cadr (car d)))
                                (list (car (nth i pts)) (cadr (nth i pts)))))
              (if (< j bd) (setq bd j best d)))))
        (if best
          (progn (setq nm (cdr best)) (setq used (cons best used)))
          (setq nm (dl:label i)))
        (setq s (strcat s (if (= i 0) "" "-") nm))
        (if (= i 0) (setq fst nm))
        (setq i (1+ i)))
      (setq s (strcat s "-" fst))
      (dl:set "kor" s)
      (dl:set "emb" (rtos ar 2 2))
      (dl:xd-read e)
      (if (not silent)
        (princ (strcat "\n" *DL-LAYER* ": " s "   |   E = " (rtos ar 2 2) " m2")))
      T)
    nil))

;; κορυφές από πίνακα συντεταγμένων (ACAD_TABLE ή μεμονωμένα TEXT)
(defun dl:table-info ( / ss e o rows i v lst txts x0 pt s)
  (princ "\nΕπιλέξτε τον πίνακα συντεταγμένων (TABLE) ή τα κείμενα των ονομασιών: ")
  (setq ss (ssget))
  (setq lst nil txts nil)
  (if ss
    (progn
      (setq i 0)
      (while (< i (sslength ss))
        (setq e (ssname ss i))
        (cond
          ((= (cdr (assoc 0 (entget e))) "ACAD_TABLE")
           (setq o (vlax-ename->vla-object e) rows (vla-get-Rows o))
           (setq v 0)
           (while (< v rows)
             (setq s (vl-string-trim " \t" (vla-GetText o v 0)))
             (if (and (> (strlen s) 0) (< (strlen s) 4) (not (wcmatch s "*/*")))
               (setq lst (cons s lst)))
             (setq v (1+ v))))
          ((member (cdr (assoc 0 (entget e))) (list "TEXT" "MTEXT"))
           (setq txts (cons (cons (cdr (assoc 10 (entget e)))
                                  (vl-string-trim " \t" (cdr (assoc 1 (entget e))))) txts)))
        )
        (setq i (1+ i)))
      ;; αν μαζέψαμε TEXT: κρατάμε την αριστερότερη στήλη, ταξινόμηση κατά Y φθίνουσα
      (if (and (null lst) txts)
        (progn
          (setq x0 (apply (function min) (mapcar (function (lambda (p) (car (car p)))) txts)))
          (setq txts (vl-remove-if-not
                       (function (lambda (p) (< (abs (- (car (car p)) x0)) (* 0.15 (getvar "VIEWSIZE"))))) txts))
          (setq txts (vl-sort txts (function (lambda (a b) (> (cadr (car a)) (cadr (car b)))))))
          (foreach p txts
            (if (and (> (strlen (cdr p)) 0) (< (strlen (cdr p)) 4))
              (setq lst (cons (cdr p) lst))))
          (setq lst (reverse lst))))
      (if lst
        (progn
          (setq lst (reverse lst))
          (setq s "")
          (foreach k lst (setq s (strcat s (if (= s "") "" "-") k)))
          (setq s (strcat s "-" (car lst)))
          (dl:set "kor" s)
          (princ (strcat "\n" s)))
        (princ "\nΔεν βρέθηκαν ονομασίες κορυφών."))))
  (princ))

