(defun dl:txt-651 ( / s n loc)
  (setq s "")
  (setq s (strcat
    "Ο υπογράφων " (dl:get "mix")
    (if (dl:nz (dl:get "eid")) (strcat ", " (dl:get "eid")) "")
    (if (dl:nz (dl:get "tee")) (strcat ", με Α.Μ. Τ.Ε.Ε. " (dl:get "tee")) "")
    ", δηλώνω υπεύθυνα και εν γνώσει των συνεπειών του νόμου ότι το εικονιζόμενο "
    (dl:eidosG)
    (if (dl:nz (dl:get "kor")) (strcat " με στοιχεία " (dl:get "kor")) "")
    (if (dl:nz (dl:get "emb")) (strcat " και εμβαδόν Ε = " (dl:get "emb") " τ.μ.") "")
    (if (dl:nz (dl:get "thesi")) (strcat ", στη θέση " (dl:get "thesi")) "")
    (if (dl:nz (dl:get "dk")) (strcat " της Δ.Κ./Τ.Κ. " (dl:get "dk")) "")
    (if (dl:nz (dl:get "dimos")) (strcat " του Δήμου " (dl:get "dimos")) "")
    (if (dl:nz (dl:get "pe")) (strcat " της Π.Ε. " (dl:get "pe")) "")
    ":"))
  (setq n 1)
  ;; 1. θέση
  (setq loc (cond
    ((= (dl:get "pos") "0") (strcat "Βρίσκεται εντός εγκεκριμένου ρυμοτομικού σχεδίου"
        (if (dl:nz (dl:get "ot")) (strcat ", στο Ο.Τ. " (dl:get "ot")) "")
        (if (dl:nz (dl:get "fekrym")) (strcat " (ΦΕΚ ρυμοτομικού: " (dl:get "fekrym") ")") "")))
    ((= (dl:get "pos") "1") "Βρίσκεται εντός των ορίων οικισμού προϋφισταμένου του έτους 1923")
    ((= (dl:get "pos") "2") (strcat "Βρίσκεται εντός των ορίων οικισμού με πληθυσμό κάτω των 2.000 κατοίκων, οριοθετημένου κατά τις διατάξεις του από 24.4.1985 Π.Δ."
        (if (dl:nz (dl:get "oikfek")) (strcat " (ΦΕΚ ορίων: " (dl:get "oikfek") ")") "")))
    (T "Βρίσκεται εκτός εγκεκριμένου ρυμοτομικού σχεδίου και εκτός ορίων οικισμού")))
  (setq s (strcat s (dl:P) (dl:++ n) ". " loc "."))
  (setq n (1+ n))
  ;; 2. θεσμικό πλαίσιο
  (if (= (dl:get "gps") "1")
    (progn (setq s (strcat s (dl:P) (dl:++ n) ". "
      "Εμπίπτει σε περιοχή εγκεκριμένου Γ.Π.Σ. / Σ.Χ.Ο.Ο.Α.Π. / Τ.Π.Σ."
      (if (dl:nz (dl:get "gpsfek")) (strcat " (" (dl:get "gpsfek") ")") "") "."))
           (setq n (1+ n))))
  (if (= (dl:get "zoe") "1")
    (progn (setq s (strcat s (dl:P) (dl:++ n) ". "
      "Εμπίπτει σε Ζώνη Οικιστικού Ελέγχου / ζώνη ειδικών χρήσεων και όρων δόμησης"
      (if (dl:nz (dl:get "zoefek")) (strcat " (" (dl:get "zoefek") ")") "") "."))
           (setq n (1+ n))))
  (if (= (dl:get "parad") "1")
    (progn (setq s (strcat s (dl:P) (dl:++ n) ". "
      "Εμπίπτει σε χαρακτηρισμένο παραδοσιακό οικισμό / ιστορικό τόπο και ισχύουν οι ειδικοί όροι και περιορισμοί δόμησης αυτού."))
           (setq n (1+ n))))
  ;; 3. αρτιότητα
  (setq s (strcat s (dl:P) (dl:++ n) ". "
    (if (= (dl:get "artio") "1")
      (strcat "Είναι άρτιο " (nth (dl:geti "vasi") *DL-VASI*)
        (if (dl:nz (dl:get "artemb")) (strcat " (ελάχιστο εμβαδόν αρτιότητας " (dl:get "artemb") " τ.μ.)") "")
        (if (= (dl:get "oik") "1") " και οικοδομήσιμο" ", πλην όμως μη οικοδομήσιμο")
        ", σύμφωνα με τις ισχύουσες πολεοδομικές διατάξεις")
      (strcat "Δεν είναι άρτιο και δεν είναι οικοδομήσιμο σύμφωνα με τις ισχύουσες πολεοδομικές διατάξεις"))
    "."))
  (setq n (1+ n))
  ;; 4. πρόσωπο
  (if (dl:nz (dl:get "pros"))
    (progn (setq s (strcat s (dl:P) (dl:++ n) ". "
      "Έχει πρόσωπο " (dl:get "pros") " μ. σε " (nth (dl:geti "odos") *DL-ODOS*) "."))
           (setq n (1+ n))))
  ;; 5. κατάτμηση
  (if (= (dl:get "katat") "1")
    (progn (setq s (strcat s (dl:P) (dl:++ n) ". "
      "Δεν προήλθε από κατάτμηση"
      (if (dl:nz (dl:get "katdate")) (strcat " μετά την " (dl:get "katdate")) "") "."))
           (setq n (1+ n))))
  ;; 6. Ν.1337/83
  (setq s (strcat s (dl:P) (dl:++ n) ". "
    (if (= (dl:get "n1337") "1")
      (strcat "Υπάγεται στις διατάξεις του Ν.1337/83 και "
        (cond
          ((and (= (dl:get "eisgi") "1") (= (dl:get "eisxr") "1")) "οφείλει εισφορά σε γη και σε χρήμα")
          ((= (dl:get "eisgi") "1") "οφείλει εισφορά σε γη")
          ((= (dl:get "eisxr") "1") "οφείλει εισφορά σε χρήμα")
          (T "δεν οφείλει εισφορά σε γη και σε χρήμα"))
        ". Η πράξη εφαρμογής είναι " (nth (dl:geti "praxi") *DL-PRAXI*))
      "Δεν υπάγεται στις διατάξεις του Ν.1337/83 και δεν οφείλει εισφορά σε γη και σε χρήμα")
    "."))
  (setq n (1+ n))
  ;; 7. Ν.2242/94
  (setq s (strcat s (dl:P) (dl:++ n) ". "
    (if (= (dl:get "n2242") "1")
      "Εμπίπτει στις διατάξεις του Ν.2242/94 (περί δηλώσεως ιδιοκτησίας στον Ο.Τ.Α.)"
      "Δεν εμπίπτει στις διατάξεις του Ν.2242/94") "."))
  (setq n (1+ n))
  ;; 8. κτηματολόγιο
  (setq s (strcat s (dl:P) (dl:++ n) ". "
    (if (= (dl:get "ktim") "1")
      (strcat "Εμπίπτει σε περιοχή λειτουργίας Εθνικού Κτηματολογίου (Ν.2308/95)"
        (if (dl:nz (dl:get "kaek")) (strcat " με ΚΑΕΚ " (dl:get "kaek")) ""))
      "Δεν εμπίπτει σε περιοχή λειτουργίας Εθνικού Κτηματολογίου") "."))
  (setq n (1+ n))
  ;; 9. δεσμεύσεις
  (setq s (strcat s (dl:P) (dl:++ n) ". " (dl:txt-desm) "."))
  (setq n (1+ n))
  ;; κλείσιμο
  (setq s (strcat s (dl:P) (dl:++ n) ". "
    "Το παρόν τοπογραφικό διάγραμμα συντάχθηκε με εξάρτηση από το Κρατικό Σύστημα Συντεταγμένων Ε.Γ.Σ.Α. 1987 και οι αναγραφόμενες συντεταγμένες των κορυφών προκύπτουν από αυτό."))
  s)

(defun dl:txt-desm ( / a b)
  (setq a nil)
  (if (= (dl:get "aig") "1")
    (setq a (cons "εντός καθορισμένης ζώνης αιγιαλού/παραλίας" a))
    (if (dl:nz (dl:get "aigd"))
      (setq a (cons (strcat "εκτός ζώνης αιγιαλού/παραλίας, σε απόσταση " (dl:get "aigd") " μ. από την ακτογραμμή") a))))
  (if (= (dl:get "rema") "1")
    (setq a (cons (strcat "σε γειτνίαση με ρέμα"
      (if (dl:nz (dl:get "remad")) (strcat " σε απόσταση " (dl:get "remad") " μ.") "")) a)))
  (if (= (dl:get "dasos") "1") (setq a (cons "εντός έκτασης χαρακτηρισμένης ως δασικής" a)))
  (if (= (dl:get "arxaio") "1") (setq a (cons "εντός ζώνης αρχαιολογικού ενδιαφέροντος" a)))
  (if (= (dl:get "dei") "1") (setq a (cons "με διερχόμενη εναέρια γραμμή υψηλής τάσης της Δ.Ε.Η." a)))
  (if (= (dl:get "aerio") "1") (setq a (cons "με διερχόμενο αγωγό φυσικού αερίου" a)))
  (if (null a)
    "Δεν εμπίπτει σε ζώνη αιγιαλού - παραλίας, δεν γειτνιάζει με ρέμα, δεν εμπίπτει σε δασική ή αρχαιολογική ζώνη και δεν διέρχονται από αυτό εναέριες γραμμές Δ.Ε.Η. ή αγωγοί φυσικού αερίου"
    (progn
      (setq b "Βρίσκεται ")
      (setq a (reverse a))
      (setq b (strcat b (car a)))
      (foreach x (cdr a) (setq b (strcat b ", " x)))
      b)))

(defun dl:txt-4030 ( / s)
  (setq s (strcat
    "Ο/Η υπογράφων/ούσα " (dl:get "idio")
    (if (dl:nz (dl:get "pat")) (strcat " του " (dl:get "pat")) "")
    (if (dl:nz (dl:get "afm")) (strcat ", με Α.Φ.Μ. " (dl:get "afm")) "")
    ", δηλώνω υπεύθυνα, κατά τις διατάξεις του άρθρου 25 του Ν.4030/2011 και του Ν.1599/1986, εν γνώσει των συνεπειών του νόμου περί ψευδούς δηλώσεως, ότι:"))
  (setq s (strcat s (dl:P) "1. "
    "Υπέδειξα ο ίδιος επί τόπου στον συντάκτη μηχανικό τη θέση και τα όρια του "
    (dl:eidosG)
    (if (dl:nz (dl:get "kor")) (strcat ", όπως αυτά αποτυπώνονται στο παρόν διάγραμμα με τα στοιχεία " (dl:get "kor")) "")
    ", τα οποία είναι τα πραγματικά όρια της ιδιοκτησίας μου και δεν καταπατούν όμορες ιδιοκτησίες ή κοινόχρηστους χώρους."))
  (setq s (strcat s (dl:P) "2. "
    "Έχω το νόμιμο δικαίωμα να αναθέσω τη σύνταξη του παρόντος τοπογραφικού διαγράμματος στον ως άνω μηχανικό."))
  (setq s (strcat s (dl:P) "3. "
    "Τα στοιχεία και οι πληροφορίες που δήλωσα και παρέδωσα στον μηχανικό για τη σύνταξη του παρόντος είναι αληθή και ακριβή."))
  s)

;; ---------------- έξοδος στο σχέδιο ----------------
(defun dl:style ( / )
  (if (not (tblsearch "STYLE" "BRB_GR"))
    (entmake (list (cons 0 "STYLE") (cons 100 "AcDbSymbolTableRecord")
                   (cons 100 "AcDbTextStyleTableRecord") (cons 2 "BRB_GR")
                   (cons 70 0) (cons 40 0.0) (cons 41 0.9) (cons 50 0.0)
                   (cons 71 0) (cons 42 2.5) (cons 3 "arial.ttf") (cons 4 ""))))
  "BRB_GR")

(defun dl:layer (nm col)
  (if (not (tblsearch "LAYER" nm))
    (entmake (list (cons 0 "LAYER") (cons 100 "AcDbSymbolTableRecord")
                   (cons 100 "AcDbLayerTableRecord") (cons 2 nm) (cons 70 0)
                   (cons 62 col) (cons 6 "Continuous"))))
  nm)

(defun dl:sc ( / k)
  (setq k (atof (dl:get "klim")))
  (if (<= k 0.0) (setq k 500.0))
  (if (= (dl:get "mon") "1") k (/ k 1000.0)))

;; σπάσιμο μεγάλου string σε κωδικούς 3/1 για entmake MTEXT
(defun dl:mt-codes (s / res n p)
  (setq res nil)
  (while (> (strlen s) 250)
    (setq n 240)
    (setq p (vl-string-position 32 (substr s 1 n) nil T))
    (if (or (null p) (< p 100)) (setq p n) (setq p (1+ p)))
    (setq res (cons (cons 3 (substr s 1 p)) res))
    (setq s (substr s (1+ p))))
  (setq res (cons (cons 1 s) res))
  (reverse res))

(defun dl:block (pt title body lay / th wd e mn mx x1 y1 x2 y2 pad hh)
  (setq th (* (atof (dl:get "hmm")) (dl:sc)))
  (setq wd (* (atof (dl:get "wmm")) (dl:sc)))
  (setq pad (* 0.6 th) hh (* 1.15 th))
  (dl:style) (dl:layer lay 7)
  ;; κυρίως κείμενο
  (entmake (append
    (list (cons 0 "MTEXT") (cons 100 "AcDbEntity") (cons 8 lay)
          (cons 100 "AcDbMText")
          (cons 10 (list (car pt) (- (cadr pt) (* 2.2 hh)) 0.0))
          (cons 40 th) (cons 41 wd) (cons 71 1) (cons 72 5)
          (cons 7 "BRB_GR"))
    (dl:mt-codes body)))
  (setq e (entlast))
  (vla-getboundingbox (vlax-ename->vla-object e) (quote mn) (quote mx))
  (setq mn (vlax-safearray->list mn) mx (vlax-safearray->list mx))
  (setq x1 (- (car pt) pad)
        x2 (+ (car pt) wd pad)
        y1 (- (cadr mn) pad)
        y2 (cadr pt))
  ;; πλαίσιο
  (entmake (list (cons 0 "LWPOLYLINE") (cons 100 "AcDbEntity") (cons 8 lay)
                 (cons 100 "AcDbPolyline") (cons 90 4) (cons 70 1)
                 (cons 10 (list x1 y1)) (cons 10 (list x2 y1))
                 (cons 10 (list x2 y2)) (cons 10 (list x1 y2))))
  ;; γραμμή τίτλου
  (entmake (list (cons 0 "LWPOLYLINE") (cons 100 "AcDbEntity") (cons 8 lay)
                 (cons 100 "AcDbPolyline") (cons 90 2) (cons 70 0)
                 (cons 10 (list x1 (- y2 (* 1.9 hh))))
                 (cons 10 (list x2 (- y2 (* 1.9 hh))))))
  ;; τίτλος
  (entmake (list (cons 0 "TEXT") (cons 100 "AcDbEntity") (cons 8 lay)
                 (cons 100 "AcDbText") (cons 7 "BRB_GR")
                 (cons 10 (list (/ (+ x1 x2) 2.0) (- y2 (* 1.45 hh)) 0.0))
                 (cons 11 (list (/ (+ x1 x2) 2.0) (- y2 (* 1.45 hh)) 0.0))
                 (cons 40 (* 1.15 th)) (cons 1 title) (cons 72 1) (cons 73 2)
                 (cons 100 "AcDbText")))
  (list x1 y1 x2 y2))

(defun dl:sign (pt lay who / th)
  (setq th (* (atof (dl:get "hmm")) (dl:sc)))
  (dl:layer lay 7)
  (entmake (list (cons 0 "MTEXT") (cons 100 "AcDbEntity") (cons 8 lay)
                 (cons 100 "AcDbMText") (cons 10 pt) (cons 40 th)
                 (cons 41 (* (atof (dl:get "wmm")) (dl:sc))) (cons 71 1) (cons 72 5)
                 (cons 7 "BRB_GR") (cons 1 who)))
  (princ))

;; ---------------- εντολές ----------------
(defun c:DILOSI ( / res pt th gap box lay)
  (setvar "CMDECHO" 0)
  (vl-cmdf "._UNDO" "_BEGIN")
  (setq res (dl:dialog))
  (if (= res 1)
    (progn
      (setq pt (getpoint "\nΣημείο εισαγωγής (πάνω-αριστερά): "))
      (if pt
        (progn
          (setq lay (dl:layer "BRB_DILOSEIS" 7))
          (setq th (* (atof (dl:get "hmm")) (dl:sc)))
          (setq gap (* 3.0 th))
          (if (= (dl:get "d651") "1")
            (progn
              (setq box (dl:block pt
                "ΔΗΛΩΣΗ Ν.651/77 & Ν.1337/83"
                (strcat (dl:txt-651) "\\P\\P"
                  "Ημερομηνία: " (dl:get "hmer") "\\P"
                  "Ο ΣΥΝΤΑΞΑΣ ΜΗΧΑΝΙΚΟΣ" "\\P\\P\\P"
                  (dl:get "mix")
                  (if (dl:nz (dl:get "eid")) (strcat "\\P" (dl:get "eid")) "")
                  (if (dl:nz (dl:get "tee")) (strcat "\\P" "Α.Μ. Τ.Ε.Ε. " (dl:get "tee")) ""))
                lay))
              (setq pt (list (car pt) (- (cadr box) gap) 0.0))))
          (if (= (dl:get "d4030") "1")
            (progn
              (setq box (dl:block pt
                "ΔΗΛΩΣΗ ΙΔΙΟΚΤΗΤΗ - ΑΡΘΡΟ 25 Ν.4030/2011"
                (strcat (dl:txt-4030) "\\P\\P"
                  "Ημερομηνία: " (dl:get "hmer") "\\P"
                  "Ο/Η ΔΗΛΩΝ/ΟΥΣΑ ΙΔΙΟΚΤΗΤΗΣ" "\\P\\P\\P"
                  (dl:get "idio"))
                lay))))
          (princ "\nΟι δηλώσεις εισήχθησαν."))
        (princ "\nΑκυρώθηκε.")))
    (princ "\nΑκυρώθηκε."))
  (vl-cmdf "._UNDO" "_END")
  (princ))

(defun c:DILOSI4030 ( / )
  (dl:init) (dl:set "d651" "0") (dl:set "d4030" "1") (c:DILOSI))

(defun c:DILOSISET ( / v)
  (dl:init)
  (setq v (getstring (strcat "\nΚλίμακα 1:" " <" (dl:get "klim") ">: ")))
  (if (/= v "") (dl:set "klim" v))
  (setq v (getstring (strcat "\nΥψος γραμμάτων σε mm χαρτιού" " <" (dl:get "hmm") ">: ")))
  (if (/= v "") (dl:set "hmm" v))
  (setq v (getstring (strcat "\nΠλάτος πλαισίου σε mm" " <" (dl:get "wmm") ">: ")))
  (if (/= v "") (dl:set "wmm" v))
  (setq v (getstring (strcat "\nLayer ιδιοκτησίας" " <" *DL-LAYER* ">: ")))
  (if (/= v "") (setq *DL-LAYER* v))
  (princ "\nΟΚ.")
  (princ))

(princ "\nHEXIS DILOSI v1.1 φορτώθηκε. Εντολές: DILOSI | DILOSI4030 | DILOSISET")
(princ)
