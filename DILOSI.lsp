;; ---------------- helpers διαλόγου ----------------
(defun dl:fill (keys) (foreach k keys (set_tile k (dl:get k))))
(defun dl:grab (keys) (foreach k keys (dl:set k (get_tile k))))
(defun dl:tabs (n / i)
  (setq i 1)
  (while (< i 6)
    (if (/= i n) (action_tile (strcat "t" (itoa i))
      (strcat "(dl:grab *KEYS*)(done_dialog " (itoa (+ 10 i)) ")")))
    (setq i (1+ i))))
(defun dl:foot (n)
  (action_tile "prev" (strcat "(dl:grab *KEYS*)(done_dialog " (itoa (+ 10 (max 1 (1- n)))) ")"))
  (action_tile "next" (strcat "(dl:grab *KEYS*)(done_dialog " (itoa (+ 10 (min 5 (1+ n)))) ")"))
  (action_tile "ins"  "(dl:grab *KEYS*)(done_dialog 1)")
  (action_tile "can"  "(done_dialog 0)"))

(defun dl:dialog ( / dcl pg res id)
  (dl:init)
  (setq dcl (dl:dclfile))
  (setq pg 1 res 99)
  (while (> pg 0)
    (setq id (load_dialog dcl))
    (if (not (new_dialog (strcat "dl" (itoa pg)) id)) (progn (setq pg 0 res 0)))
    (if (> pg 0)
      (progn
        (cond
          ((= pg 1)
           (setq *KEYS* (list "kor" "emb" "thesi" "dk" "dimos" "pe" "ot" "kaek"))
           (start_list "eidos") (mapcar (function add_list) *DL-EIDOS*) (end_list)
           (set_tile "eidos" (dl:get "eidos"))
           (dl:fill *KEYS*)
           (action_tile "eidos" "(dl:set \"eidos\" $value)")
           (action_tile "bpoly" "(dl:grab *KEYS*)(done_dialog 21)")
           (action_tile "btab"  "(dl:grab *KEYS*)(done_dialog 22)"))
          ((= pg 2)
           (setq *KEYS* (list "gps" "gpsfek" "zoe" "zoefek" "parad" "fekrym" "fekoron" "oikfek"))
           (set_tile (strcat "p" (dl:get "pos")) "1")
           (dl:fill *KEYS*)
           (action_tile "pos" "(dl:set \"pos\" (substr $value 2))"))
          ((= pg 3)
           (setq *KEYS* (list "artemb" "oik" "pros" "katat" "katdate"))
           (start_list "vasi") (mapcar (function add_list) *DL-VASI*) (end_list)
           (set_tile "vasi" (dl:get "vasi"))
           (start_list "odos") (mapcar (function add_list) *DL-ODOS*) (end_list)
           (set_tile "odos" (dl:get "odos"))
           (set_tile (strcat "a" (dl:get "artio")) "1")
           (dl:fill *KEYS*)
           (action_tile "vasi" "(dl:set \"vasi\" $value)")
           (action_tile "odos" "(dl:set \"odos\" $value)")
           (action_tile "artio" "(dl:set \"artio\" (substr $value 2))"))
          ((= pg 4)
           (setq *KEYS* (list "n1337" "eisgi" "eisxr" "n2242" "ktim" "aig" "aigd"
                              "rema" "remad" "dasos" "arxaio" "dei" "aerio"))
           (start_list "praxi") (mapcar (function add_list) *DL-PRAXI*) (end_list)
           (set_tile "praxi" (dl:get "praxi"))
           (dl:fill *KEYS*)
           (action_tile "praxi" "(dl:set \"praxi\" $value)"))
          ((= pg 5)
           (setq *KEYS* (list "mix" "eid" "tee" "idio" "pat" "afm" "klim" "hmm" "wmm"
                              "d651" "d4030" "hmer"))
           (set_tile (strcat "m" (dl:get "mon")) "1")
           (dl:fill *KEYS*)
           (action_tile "mon" "(dl:set \"mon\" (substr $value 2))"))
        )
        (dl:tabs pg)
        (dl:foot pg)
        (setq res (start_dialog))
        (unload_dialog id)
        (cond
          ((= res 0) (setq pg 0))
          ((= res 1) (setq pg 0))
          ((= res 21) (dl:prop-info nil) (setq pg 1))
          ((= res 22) (dl:table-info) (setq pg 1))
          ((and (> res 10) (< res 16)) (setq pg (- res 10)))
          (T (setq pg 0))))))
  res)

